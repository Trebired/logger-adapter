{
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "displayName": "Trebired",
      "name": "trebired",
      "website": "https://trebired.com"
    }
  },
  "name": "@trebired/logger-adapter",
  "version": "0.4.16",
  "description": "Generic structured logger adapter with server, browser, bridge, and Rust client support.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "logger-adapter-bridge": "./dist/bridge/server.js"
  },
  "exports": {
    ".": {
      "browser": {
        "import": "./dist/browser/index.js",
        "types": "./dist/index.d.ts"
      },
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser/index.js",
      "types": "./dist/browser/index.d.ts"
    },
    "./bridge": {
      "import": "./dist/bridge/server.js",
      "types": "./dist/bridge/server.d.ts"
    },
    "./bridge/protocol": {
      "import": "./dist/bridge/protocol.js",
      "types": "./dist/bridge/protocol.d.ts"
    }
  },
  "files": [
    ".trebired/logger/config.ts",
    "dist",
    "rust",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run prepare:generated && rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs prepare-dist",
    "demo": "bun run examples/dummy.ts",
    "prepublishOnly": "bun run typecheck && bun run build && bun run verify:adapter && bun run verify:bridge && bun run verify:rust && bun run verify:pack",
    "prepare:generated": "bun ./scripts/build/generated/tsconfig.mjs",
    "typecheck": "bun run prepare:generated && tsc --noEmit",
    "prepack": "bun run build && bun ./scripts/prepare-dist.mjs prepack",
    "postpack": "bun ./scripts/prepare-dist.mjs postpack",
    "verify:adapter": "bun ./scripts/verify/adapter.mjs",
    "verify:bridge": "bun ./scripts/verify/bridge.mjs",
    "verify:pack": "bun ./scripts/verify/pack.mjs",
    "verify:rust": "bun ./scripts/verify/rust.mjs"
  },
  "dependencies": {
    "@package/logger": "npm:@trebired/logger@^2.5.28",
    "@trebired/utils": "^0.6.0"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^7.0.0",
    "@trebired/configs": "^0.2.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@trebired/logger": "^2.5.29"
  },
  "peerDependenciesMeta": {
    "@trebired/logger": {
      "optional": true
    }
  },
  "keywords": [
    "logger",
    "logging",
    "adapter",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/logger-adapter"
  },
  "homepage": "https://github.com/Trebired/logger-adapter#readme",
  "bugs": {
    "url": "https://github.com/Trebired/logger-adapter/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
