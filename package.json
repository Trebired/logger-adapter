{
  "name": "@trebired/logger-adapter",
  "version": "0.3.1",
  "description": "Logger adapter for @trebired/logger-compatible server and browser calls with common logger and custom writer support.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "name": "trebired"
    }
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "import": "./dist/browser/index.js",
        "types": "./dist/index.d.ts"
      },
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser/index.js",
      "types": "./dist/browser/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run prepare:generated && rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs prepare-dist",
    "demo": "bun run examples/dummy.ts",
    "prepublishOnly": "bun run typecheck && bun run verify:pack",
    "prepare:generated": "bun ./scripts/build/generated/tsconfig.mjs",
    "typecheck": "bun run prepare:generated && tsc --noEmit",
    "prepack": "bun run build && bun ./scripts/prepare-dist.mjs prepack",
    "postpack": "bun ./scripts/prepare-dist.mjs postpack",
    "verify:pack": "bun ./scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^4.10.0",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.1",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@trebired/logger": ">=2.5"
  },
  "peerDependenciesMeta": {
    "@trebired/logger": {
      "optional": true
    }
  },
  "keywords": [
    "logger",
    "logging",
    "adapter",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/logger-adapter"
  },
  "homepage": "https://github.com/Trebired/logger-adapter#readme",
  "bugs": {
    "url": "https://github.com/Trebired/logger-adapter/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
